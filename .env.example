# ============================================
# AbiArt — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# Flask Configuration
FLASK_PORT=5000
FLASK_DEBUG=false
SECRET_KEY=change-me-to-a-random-string

# Database Configuration (PostgreSQL on Railway / SQLite locally)
# If left empty, SQLite (abiart.db) will be used automatically.
# On Railway, adding the Postgres plugin sets DATABASE_URL automatically.
DATABASE_URL=postgresql://user:password@localhost:5432/abiart

# Admin Account (created on first startup)
ADMIN_USERNAME=malowvx
ADMIN_PASSWORD=zaza1140

# Modal Backend URLs
# These are generated when you run: modal serve modal_sd.py
# Replace with your own Modal endpoint URLs
MODAL_GENERATE_URL=https://YOUR_USERNAME--stable-diffusion-api-stablediffusion-api-generate-dev.modal.run
MODAL_MODELS_URL=https://YOUR_USERNAME--stable-diffusion-api-stablediffusion-list-models-dev.modal.run
MODAL_LOAD_URL=https://YOUR_USERNAME--stable-diffusion-api-stablediffusion-load-civitai-model-dev.modal.run
MODAL_DELETE_URL=https://YOUR_USERNAME--stable-diffusion-api-stablediffusion-delete-model-dev.modal.run
MODAL_IMG2IMG_URL=https://YOUR_USERNAME--stable-diffusion-api-stablediffusion-api-img2img-dev.modal.run
MODAL_UPSCALE_URL=https://YOUR_USERNAME--stable-diffusion-api-stablediffusion-api-upscale-dev.modal.run

# Hugging Face Token (optional/recommended — for FLUX, SD 3.5, background removal, upscaling)
# Get yours at: https://huggingface.co/settings/tokens
HF_TOKEN=

# Civitai API Token (optional — for downloading models)
# Get yours at: https://civitai.com/user/account
CIVITAI_TOKEN=
